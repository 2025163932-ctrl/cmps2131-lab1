digraph tokens {
  rankdir=LR;
  node [shape=record];
  n0 [label="{ROUTE|route}"];
  n0 -> n1;
  n1 [label="{IDENT|primary}"];
  n1 -> n2;
  n2 [label="{ARROW|-\>}"];
  n2 -> n3;
  n3 [label="{NODE|node}"];
  n3 -> n4;
  n4 [label="{IDENT|gateway}"];
  n4 -> n5;
  n5 [label="{SEMICOLON|;}"];
  n5 -> n6;
  n6 [label="{EOF|}"];
  n6 -> nnull;
  nnull [shape=point];
}
